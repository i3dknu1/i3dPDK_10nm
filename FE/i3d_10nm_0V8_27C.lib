  /******************************************************************************************
   Module          	: TBUF_X1
   Cell Description	: Combinational tri-state cell (TBUF_X1) with drive strength X1
  *******************************************************************************************/

  cell(AND2_X1) { 
    area : 0.042 ; 
    cell_leakage_power : 404.7 ; 

    leakage_power() { 
      when : "A1&A2" ; 
      value : "627.3" ; 
    }

    leakage_power() { 
      when : "!A1&!A2" ; 
      value : "404.7" ; 
    }

    leakage_power() { 
      when : "A1&!A2" ; 
      value : "567" ; 
    }

    leakage_power() { 
      when : "!A1&A2" ; 
      value : "573.6" ; 
    }
    rail_connection(VDD, RAIL_VDD);
    rail_connection(VSS, RAIL_VSS);

    pin(A1) { 
      direction : input ; 
      driver_waveform_rise : "driver_waveform_default_rise" ; 
      driver_waveform_fall : "driver_waveform_default_fall" ; 
      fall_capacitance : 1.004 ; 
      fall_capacitance_range(0.6021, 1.004);
      input_signal_level : RAIL_VDD ; 
      capacitance : 1.004 ; 
      max_transition : 0.6 ; 
      rise_capacitance : 0.9975 ; 
      rise_capacitance_range(0.5867, 0.9975);

      internal_power() { 

        rise_power(passive_energy_template_7x1) { 
          index_1("0.0075, 0.01875, 0.0375, 0.075, 0.15, 0.3, 0.6");
          values("-0.2312, -0.2311, -0.2311, -0.2312, -0.2314, -0.2315, -0.2315");
        }

        fall_power(passive_energy_template_7x1) { 
          index_1("0.0075, 0.01875, 0.0375, 0.075, 0.15, 0.3, 0.6");
          values("0.3154, 0.3154, 0.3153, 0.3154, 0.3155, 0.3154, 0.3155");
        }
      }
    }

    pin(A2) { 
      direction : input ; 
      driver_waveform_rise : "driver_waveform_default_rise" ; 
      driver_waveform_fall : "driver_waveform_default_fall" ; 
      fall_capacitance : 0.9884 ; 
      fall_capacitance_range(0.6793, 0.9884);
      input_signal_level : RAIL_VDD ; 
      capacitance : 1.016 ; 
      max_transition : 0.6 ; 
      rise_capacitance : 1.016 ; 
      rise_capacitance_range(0.6953, 1.016);

      internal_power() { 

